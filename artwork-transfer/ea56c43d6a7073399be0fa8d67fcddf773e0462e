{
  "name": "star-cat-monopoly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "星猫大富翁原版兼容运行 · Vue + TypeScript + Ruffle",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "predev": "node scripts/prepare-runtime.mjs",
    "prebuild": "node scripts/prepare-runtime.mjs",
    "test:e2e": "playwright test",
    "dev:modern": "vite --mode modern --host 127.0.0.1",
    "build:modern": "vue-tsc --noEmit && vite build --mode modern",
    "preview:modern": "vite preview --mode modern --host 127.0.0.1 --port 4184",
    "data:modern": "node scripts/build-modern-map.mjs",
    "test:e2e:modern": "playwright test --config playwright.modern.config.ts"
  },
  "dependencies": {
    "@ruffle-rs/ruffle": "0.6.0",
    "pinia": "^4.0.3",
    "pixi.js": "8.20.1",
    "three": "^0.186.0",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.5.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^30.0.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
