<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><title>3D原版受控规则探针</title></head><body><h1>3D原版受控规则探针</h1><p>原函数执行；不是原版自然开局。未修改保留的SWF。</p><button id="run">运行原版探针</button><pre id="result">等待运行</pre><div id="host"></div><script src="/node_modules/@ruffle-rs/ruffle/ruffle.js"></script><script>
document.querySelector('#run').onclick=async()=>{try{const player=window.RufflePlayer.newest().createPlayer();document.querySelector('#host').append(player);await player.ruffle().load({url:'/.analysis-cache/3d-probe/probe.swf',autoplay:'on',unmuteOverlay:'hidden',allowScriptAccess:true});let timer=setInterval(()=>{try{let value=player.ruffle().callExternalInterface('probeResult');if(value){document.querySelector('#result').textContent=value;clearInterval(timer);}}catch(error){document.querySelector('#result').textContent=String(error);}},100);}catch(error){document.querySelector('#result').textContent=String(error);}}
</script></body></html>
