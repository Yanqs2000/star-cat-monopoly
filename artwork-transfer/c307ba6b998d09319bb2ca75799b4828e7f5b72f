import { test, expect } from '@playwright/test'
import { playUntil, revealGameDetails } from './modern-play'

test('高清自然seed39收费先展示房屋，再将960元转入地主存款且只结算一次', async ({ page }) => {
  test.setTimeout(180_000)
  const errors: string[] = []; page.on('pageerror', error => errors.push(error.message))
  await page.setViewportSize({ width: 1366, height: 768 })
  await page.addInitScript(() => {
    localStorage.setItem('star-cat-monopoly:asset-profile', 'hd')
    const random = crypto.getRandomValues.bind(crypto)
    crypto.getRandomValues = array => { if (array instanceof Uint32Array && array.length === 1) { array[0] = 39; return array }; return random(array) }
    Date.prototype.getDay = () => 1; Date.prototype.getFullYear = () => 2026; Date.prototype.getMonth = () => 9; Date.prototype.getDate = () => 26
  })
  await page.goto('/modern.html'); await expect(page).toHaveTitle(/星猫大富翁/)
  await page.getByTestId('character-1').click(); await page.getByRole('button', { name: '开始对局', exact: true }).click()
  await expect(page.getByRole('status')).toContainText('对局已载入')
  await revealGameDetails(page); await page.getByLabel('速度').selectOption('2')
  const panel = page.locator('.rent-panel')
  await playUntil(page, async () => await panel.count() > 0, 1000)
  await expect(panel).toContainText('正在标出收费房屋')
  await page.getByRole('button', { name: '暂停对局', exact: true }).click()
  const read = async () => JSON.parse((await page.getByTestId('game-state-fingerprint').getAttribute('data-state-json'))!)
  const before = await read()
  expect(before.propertyOffer).toMatchObject({ kind: 'rent', parcelId: 13, amount: 960, ownerId: 2 })
  await expect(panel).toContainText('#13'); await expect(panel).toContainText('#9')
  await expect(panel.locator('.rent-items strong')).toHaveText(['480 元', '480 元'])
  await expect(panel).toContainText('必须支付租金 960')
  await expect(panel.getByRole('button')).toHaveCount(0)
  await page.waitForTimeout(1700)
  expect((await read()).players).toEqual(before.players)
  await page.screenshot({ path: '/tmp/starcat-rent-before-payment.png' })
  await page.setViewportSize({ width: 390, height: 844 })
  await page.getByTestId('toggle-game-details').click()
  await expect(page.getByTestId('toggle-game-details')).toHaveAttribute('aria-expanded', 'false')
  await expect(panel).toBeVisible()
  const bounds = await panel.boundingBox(); expect(bounds!.x).toBeGreaterThanOrEqual(0); expect(bounds!.x + bounds!.width).toBeLessThanOrEqual(390)
  await page.screenshot({ path: '/tmp/starcat-rent-mobile.png' })
  await page.setViewportSize({ width: 1366, height: 768 })
  await page.getByRole('button', { name: '继续对局', exact: true }).click()
  await expect(panel).toContainText('1 秒后自动扣款')
  await page.waitForTimeout(500)
  expect((await read()).players).toEqual(before.players)
  await expect.poll(async () => (await read()).lastPropertyEvent).toMatchObject({ kind: 'rent-paid', parcelId: 13, amount: 960, recipientId: 2 })
  const after = await read()
  expect(after.players[3].cash).toBe(before.players[3].cash - 960)
  expect(after.players[1].deposit).toBe(before.players[1].deposit + 960)
  await expect(page.locator('vite-error-overlay')).toHaveCount(0)
  expect(errors).toEqual([])
})
